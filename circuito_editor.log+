<log+>
// EDITOR Y SIMULADOR DE CIRCUITOS - arma tus propios circuitos tocando la pantalla. No necesita extensiones.
// Piezas: BAT (bateria), FOCO (resistencia con luz), SW (interruptor), CABLE.
// Para poner una pieza: elige la herramienta de abajo, toca un punto de la cuadricula y luego otro punto en la misma fila o columna.
// En la bateria, el primer punto es el negativo (-) y el segundo el positivo (+, placa larga).
// BORRAR: toca el centro de una pieza para quitarla. EDITAR: toca el centro de un interruptor para abrirlo/cerrarlo,
// o de una bateria/foco para ponerle el valor V o R que tengas elegido con los botones - y +.
// EJEMPLO alterna entre un circuito en serie y uno en paralelo. LIMPIAR borra todo.
// El simulador resuelve el circuito completo con analisis nodal (ley de Ohm y leyes de Kirchhoff).

Var:etype("List;")
Var:ea("List;")
Var:eb("List;")
Var:ev("List;")
Var:eph("List;")
Var:ia("List;")
Var:ib("List;")
Var:ecur("List;")
Var:ebri("List;")
Var:par("Size;90","Fill;0")
Var:idx("Size;90","Fill;-1")
Var:vn("Size;16","Fill;0")
Var:mat("Size;200","Fill;0")

Var:mx("Value;0")
Var:my("Value;0")
Var:herr("Value;2")
Var:pend("Value;-1")
Var:est("Value;0")
Var:vbat("Value;6")
Var:rfoc("Value;6")
Var:ejem("Value;0")
Var:nn("Value;0")
Var:nbat("Value;0")
Var:fb("Value;-1")
Var:ra("Value;0")
Var:rb("Value;0")
Var:rz("Value;0")
Var:n("Value;0")
Var:w("Value;1")
Var:p("Value;0")
Var:q("Value;0")
Var:g("Value;0")
Var:src("Value;0")
Var:pv("Value;1")
Var:f("Value;0")
Var:sm("Value;0")
Var:cur("Value;0")
Var:pw("Value;0")
Var:itot("Value;0")
Var:sIt("Value;0")
Var:cortoc("Value;0")
Var:en("Value;0")
Var:besti("Value;-1")
Var:bestd("Value;0")
Var:dist("Value;0")
Var:pc("Value;0")
Var:pr("Value;0")
Var:nodo("Value;0")
Var:fila("Value;0")
Var:colu("Value;0")
Var:ka("Value;0")
Var:kb("Value;0")
Var:x1("Value;0")
Var:y1("Value;0")
Var:x2("Value;0")
Var:y2("Value;0")
Var:xm("Value;0")
Var:ym("Value;0")
Var:ln("Value;20")
Var:ux("Value;1")
Var:uy("Value;0")
Var:qx("Value;0")
Var:qy("Value;1")
Var:bb("Value;0")
Var:pos("Value;0")

Def:raiz(nd)
{
    Set:rz("Value;nd")
    While(par[rz]!=rz)
    {
        Set:rz("Value;par[rz]")
    }
    Return("Value;rz")
}

Def:agregar(tp,na,nb,val)
{
    Push:etype("Value;tp")
    Push:ea("Value;na")
    Push:eb("Value;nb")
    Push:ev("Value;val")
    Push:eph("Value;0")
}

Def:resolver()
{
    Var:par("Size;90","Fill;0")
    Var:idx("Size;90","Fill;-1")
    Var:vn("Size;16","Fill;0")
    Var:ia("List;")
    Var:ib("List;")
    Var:ecur("List;")
    Var:ebri("List;")
    For:k(0,90)
    {
        Set:par("Index;k","Value;k")
    }
    For:ed(0,etype.length)
    {
        If(etype[ed]==0 || etype[ed]==3)
        {
            Call:raiz(ea[ed])("Into;ra")
            Call:raiz(eb[ed])("Into;rb")
            If(ra!=rb)
            {
                Set:par("Index;ra","Value;rb")
            }
        }
    }
    Set:nn("Value;0")
    Set:nbat("Value;0")
    Set:fb("Value;-1")
    For:ed(0,etype.length)
    {
        If(etype[ed]==1)
        {
            Set:nbat("Value;nbat+1")
            If(fb<0)
            {
                Set:fb("Value;ed")
            }
        }
    }
    If(fb>=0)
    {
        Call:raiz(ea[fb])("Into;ra")
        Set:idx("Index;ra","Value;0")
        Set:nn("Value;1")
    }
    For:ed(0,etype.length)
    {
        If((etype[ed]==1 || etype[ed]==2) && fb>=0)
        {
            Call:raiz(ea[ed])("Into;ra")
            Call:raiz(eb[ed])("Into;rb")
            If(idx[ra]<0)
            {
                Set:idx("Index;ra","Value;nn")
                Set:nn("Value;nn+1")
            }
            If(idx[rb]<0)
            {
                Set:idx("Index;rb","Value;nn")
                Set:nn("Value;nn+1")
            }
            Push:ia("Value;idx[ra]")
            Push:ib("Value;idx[rb]")
        }
        Else
        {
            Push:ia("Value;-1")
            Push:ib("Value;-1")
        }
    }
    If(nn>14)
    {
        Set:est("Value;5")
        Set:fb("Value;-1")
        Var:ia("List;")
        Var:ib("List;")
        For:ed(0,etype.length)
        {
            Push:ia("Value;-1")
            Push:ib("Value;-1")
        }
    }
    If(fb>=0 && nn>1)
    {
        Var:mat("Size;200","Fill;0")
        Set:n("Value;nn-1")
        Set:w("Value;n+1")
        For:r(0,n)
        {
            Set:mat("Index;r*w+r","Value;0.000001")
        }
        For:ed(0,etype.length)
        {
            If(ia[ed]>=0 && ia[ed]!=ib[ed])
            {
                Set:p("Value;ia[ed]")
                Set:q("Value;ib[ed]")
                If(etype[ed]==1)
                {
                    Set:g("Value;10")
                    Set:src("Value;ev[ed]*10")
                }
                Else
                {
                    Set:g("Value;1/ev[ed]")
                    Set:src("Value;0")
                }
                If(p>0)
                {
                    Set:mat("Index;(p-1)*w+p-1","Value;mat[(p-1)*w+p-1]+g")
                    Set:mat("Index;(p-1)*w+n","Value;mat[(p-1)*w+n]-src")
                    If(q>0)
                    {
                        Set:mat("Index;(p-1)*w+q-1","Value;mat[(p-1)*w+q-1]-g")
                    }
                }
                If(q>0)
                {
                    Set:mat("Index;(q-1)*w+q-1","Value;mat[(q-1)*w+q-1]+g")
                    Set:mat("Index;(q-1)*w+n","Value;mat[(q-1)*w+n]+src")
                    If(p>0)
                    {
                        Set:mat("Index;(q-1)*w+p-1","Value;mat[(q-1)*w+p-1]-g")
                    }
                }
            }
        }
        For:c(0,n)
        {
            Set:pv("Value;mat[c*w+c]")
            For:r(c+1,n)
            {
                Set:f("Value;mat[r*w+c]/pv")
                If(f!=0)
                {
                    For:k(c,w)
                    {
                        Set:mat("Index;r*w+k","Value;mat[r*w+k]-f*mat[c*w+k]")
                    }
                }
            }
        }
        For:i(0,n)
        {
            Set:r("Value;n-1-i")
            Set:sm("Value;mat[r*w+n]")
            For:k(r+1,n)
            {
                Set:sm("Value;sm-mat[r*w+k]*vn[k+1]")
            }
            Set:vn("Index;r+1","Value;sm/mat[r*w+r]")
        }
    }
    Set:itot("Value;0")
    Set:cortoc("Value;0")
    For:ed(0,etype.length)
    {
        Set:cur("Value;0")
        If(ia[ed]>=0)
        {
            If(etype[ed]==2)
            {
                Set:cur("Value;(vn[ia[ed]]-vn[ib[ed]])/ev[ed]")
            }
            If(etype[ed]==1)
            {
                Set:cur("Value;10*(ev[ed]-(vn[ib[ed]]-vn[ia[ed]]))")
                Set:itot("Value;itot+max(0,cur)")
                If(ia[ed]==ib[ed])
                {
                    Set:cortoc("Value;1")
                }
            }
        }
        Push:ecur("Value;cur")
        If(etype[ed]==2)
        {
            Set:pw("Value;cur*cur*ev[ed]")
            Push:ebri("Value;min(1,pw/4)")
        }
        Else
        {
            Push:ebri("Value;0")
        }
    }
    Set:en("Value;itot>0.001?1:0")
    Set:sIt("Value;floor(itot*100)/100")
}

Def:limpiar()
{
    Var:etype("List;")
    Var:ea("List;")
    Var:eb("List;")
    Var:ev("List;")
    Var:eph("List;")
    Set:pend("Value;-1")
    Set:est("Value;0")
    Call:resolver()
}

Def:ejemplo()
{
    Var:etype("List;")
    Var:ea("List;")
    Var:eb("List;")
    Var:ev("List;")
    Var:eph("List;")
    If(ejem==0)
    {
        Call:agregar(1,62,17,6)
        Call:agregar(0,17,19,0)
        Call:agregar(3,19,22,0)
        Call:agregar(2,22,26,4)
        Call:agregar(0,26,71,0)
        Call:agregar(2,71,67,4)
        Call:agregar(0,67,62,0)
        Set:ejem("Value;1")
    }
    Else
    {
        Call:agregar(1,62,17,6)
        Call:agregar(3,17,21,0)
        Call:agregar(0,21,25,0)
        Call:agregar(2,21,66,6)
        Call:agregar(2,25,70,6)
        Call:agregar(0,62,66,0)
        Call:agregar(0,66,70,0)
        Set:ejem("Value;0")
    }
    Set:pend("Value;-1")
    Set:est("Value;0")
    Call:resolver()
}

Def:cercano()
{
    Set:besti("Value;-1")
    Set:bestd("Value;999999")
    For:ci(0,etype.length)
    {
        Set:ka("Value;ea[ci]")
        Set:kb("Value;eb[ci]")
        Set:xm("Value;(20+20*(ka%15)+20+20*(kb%15))/2")
        Set:ym("Value;(24+20*floor(ka/15)+24+20*floor(kb/15))/2")
        Set:dist("Value;(mx-xm)*(mx-xm)+(my-ym)*(my-ym)")
        If(dist<bestd)
        {
            Set:bestd("Value;dist")
            Set:besti("Value;ci")
        }
    }
}

Def:toque()
{
    If(my>=138)
    {
        If(my<=156)
        {
            If(mx>=3 && mx<=55)
            {
                Set:herr("Value;1")
            }
            If(mx>=56 && mx<=108)
            {
                Set:herr("Value;2")
            }
            If(mx>=109 && mx<=161)
            {
                Set:herr("Value;3")
            }
            If(mx>=162 && mx<=214)
            {
                Set:herr("Value;4")
            }
            If(mx>=215 && mx<=267)
            {
                Set:herr("Value;5")
            }
            If(mx>=268 && mx<=319)
            {
                Set:herr("Value;6")
            }
            Set:pend("Value;-1")
            Set:est("Value;0")
        }
        ElseIf(my>=158)
        {
            If(mx>=38 && mx<=56)
            {
                Set:vbat("Value;max(1,vbat-1)")
            }
            If(mx>=58 && mx<=76)
            {
                Set:vbat("Value;min(12,vbat+1)")
            }
            If(mx>=116 && mx<=134)
            {
                Set:rfoc("Value;max(1,rfoc-1)")
            }
            If(mx>=136 && mx<=154)
            {
                Set:rfoc("Value;min(20,rfoc+1)")
            }
            If(mx>=160 && mx<=236)
            {
                Call:ejemplo()
            }
            If(mx>=240 && mx<=316)
            {
                Call:limpiar()
            }
        }
    }
    ElseIf(my<=135)
    {
        If(herr<=4)
        {
            Set:pc("Value;max(0,min(14,floor((mx-10)/20)))")
            Set:pr("Value;max(0,min(5,floor((my-14)/20)))")
            Set:nodo("Value;pr*15+pc")
            If(pend<0)
            {
                Set:pend("Value;nodo")
                Set:est("Value;1")
            }
            Else
            {
                If(nodo==pend)
                {
                    Set:pend("Value;-1")
                    Set:est("Value;0")
                }
                Else
                {
                    Set:fila("Value;floor(pend/15)")
                    Set:colu("Value;pend%15")
                    If(fila==pr || colu==pc)
                    {
                        If(etype.length>=30)
                        {
                            Set:est("Value;4")
                            Set:pend("Value;-1")
                        }
                        Else
                        {
                            If(herr==1)
                            {
                                Call:agregar(1,pend,nodo,vbat)
                            }
                            If(herr==2)
                            {
                                Call:agregar(2,pend,nodo,rfoc)
                            }
                            If(herr==3)
                            {
                                Call:agregar(3,pend,nodo,0)
                            }
                            If(herr==4)
                            {
                                Call:agregar(0,pend,nodo,0)
                            }
                            Set:pend("Value;-1")
                            Set:est("Value;0")
                            Call:resolver()
                        }
                    }
                    Else
                    {
                        Set:est("Value;2")
                    }
                }
            }
        }
        Else
        {
            Call:cercano()
            If(besti>=0 && bestd<225)
            {
                If(herr==5)
                {
                    Remove:etype("Index;besti")
                    Remove:ea("Index;besti")
                    Remove:eb("Index;besti")
                    Remove:ev("Index;besti")
                    Remove:eph("Index;besti")
                    Call:resolver()
                }
                If(herr==6)
                {
                    If(etype[besti]==3)
                    {
                        Set:etype("Index;besti","Value;4")
                    }
                    Else
                    {
                        If(etype[besti]==4)
                        {
                            Set:etype("Index;besti","Value;3")
                        }
                    }
                    If(etype[besti]==1)
                    {
                        Set:ev("Index;besti","Value;vbat")
                    }
                    If(etype[besti]==2)
                    {
                        Set:ev("Index;besti","Value;rfoc")
                    }
                    Call:resolver()
                }
            }
        }
    }
}

Def:cable(xa,ya,xb,yb)
{
    If(ya==yb)
    {
        Screen:Rect(min(xa,xb),ya-1,abs(xb-xa)+1,2)("Color;rgb;120+135*en;120+60*en;120-60*en")
    }
    Else
    {
        Screen:Rect(xa-1,min(ya,yb),2,abs(yb-ya)+1)("Color;rgb;120+135*en;120+60*en;120-60*en")
    }
}

Def:boton(xb,yb,wb,k)
{
    Screen:Rect(xb,yb,wb,18)("Color;rgb;herr==k?47:42;herr==k?111:58;herr==k?237:74")
}

Def:pieza(pz)
{
    Set:ka("Value;ea[pz]")
    Set:kb("Value;eb[pz]")
    Set:x1("Value;20+20*(ka%15)")
    Set:y1("Value;24+20*floor(ka/15)")
    Set:x2("Value;20+20*(kb%15)")
    Set:y2("Value;24+20*floor(kb/15)")
    Set:ln("Value;abs(x2-x1)+abs(y2-y1)")
    Set:ux("Value;(x2-x1)/ln")
    Set:uy("Value;(y2-y1)/ln")
    Set:xm("Value;(x1+x2)/2")
    Set:ym("Value;(y1+y2)/2")
    Set:qx("Value;0-uy")
    Set:qy("Value;ux")
    If(etype[pz]==0)
    {
        Call:cable(x1,y1,x2,y2)
    }
    Else
    {
        Call:cable(x1,y1,xm-ux*9,ym-uy*9)
        Call:cable(xm+ux*9,ym+uy*9,x2,y2)
        If((etype[pz]==1 || etype[pz]==2) && abs(ecur[pz])>0.005)
        {
            For:kd(0,3)
            {
                Set:pos("Value;((eph[pz]+kd*ln/3)%ln+ln)%ln")
                Screen:Rect(x1+ux*pos-1,y1+uy*pos-1,3,3)("Color;#ffe066")
            }
        }
        If(etype[pz]==2)
        {
            Set:bb("Value;ebri[pz]")
            Screen:Circle(xm,ym,8)("Color;#3a4a5a")
            Screen:Circle(xm,ym,7+floor(bb*5))("Color;rgb;30+120*bb;25+90*bb;10")
            Screen:Circle(xm,ym,6)("Color;rgb;60+195*bb;50+175*bb;30+60*bb")
            If(uy==0)
            {
                Screen:Text(xm-12,ym-20)("Text;{ev[pz]}R","Color;#9fb3c8")
            }
            Else
            {
                Screen:Text(xm+10,ym-4)("Text;{ev[pz]}R","Color;#9fb3c8")
            }
        }
        If(etype[pz]==1)
        {
            Screen:Line(xm+ux*3-qx*8,ym+uy*3-qy*8,xm+ux*3+qx*8,ym+uy*3+qy*8)("Color;white")
            Screen:Line(xm+ux*4-qx*8,ym+uy*4-qy*8,xm+ux*4+qx*8,ym+uy*4+qy*8)("Color;white")
            Screen:Line(xm-ux*3-qx*4,ym-uy*3-qy*4,xm-ux*3+qx*4,ym-uy*3+qy*4)("Color;white")
            Screen:Line(xm-ux*4-qx*4,ym-uy*4-qy*4,xm-ux*4+qx*4,ym-uy*4+qy*4)("Color;white")
            Screen:Text(xm+ux*13+qx*9-4,ym+uy*13+qy*9-4)("Text;+","Color;#ff6b6b")
            If(uy==0)
            {
                Screen:Text(xm-12,ym-20)("Text;{ev[pz]}V","Color;#9fb3c8")
            }
            Else
            {
                Screen:Text(xm+10,ym-4)("Text;{ev[pz]}V","Color;#9fb3c8")
            }
        }
        If(etype[pz]==3 || etype[pz]==4)
        {
            Screen:Circle(xm-ux*9,ym-uy*9,2)("Color;white")
            Screen:Circle(xm+ux*9,ym+uy*9,2)("Color;white")
            If(etype[pz]==3)
            {
                Call:cable(xm-ux*9,ym-uy*9,xm+ux*9,ym+uy*9)
            }
            Else
            {
                Screen:Line(xm-ux*9,ym-uy*9,xm-ux*9+ux*9+qx*8,ym-uy*9+uy*9+qy*8)("Color;white")
            }
        }
    }
}

Def:dibujar()
{
    Screen:Clear("Color;#101820")
    For:gr(0,6)
    {
        For:gc(0,15)
        {
            Screen:Rect(19+20*gc,23+20*gr,2,2)("Color;#3a4a5a")
        }
    }
    For:ei(0,etype.length)
    {
        Call:pieza(ei)
    }
    If(pend>=0)
    {
        Screen:Circle(20+20*(pend%15),24+20*floor(pend/15),4)("Color;#ffd166")
    }

    If(cortoc==1)
    {
        Screen:Text(4,3)("Text;CORTOCIRCUITO!","Color;#ff6b6b")
    }
    ElseIf(est==0 && nbat==0 && etype.length>0)
    {
        Screen:Text(4,3)("Text;Falta una bateria (BAT)","Color;#ffd166")
    }
    ElseIf(est==0)
    {
        Screen:Text(4,3)("Text;Elige pieza y toca 2 puntos","Color;#9fb3c8")
    }
    ElseIf(est==1)
    {
        Screen:Text(4,3)("Text;Toca el segundo punto","Color;#ffd166")
    }
    ElseIf(est==2)
    {
        Screen:Text(4,3)("Text;Solo en fila o columna recta","Color;#ff6b6b")
    }
    ElseIf(est==4)
    {
        Screen:Text(4,3)("Text;Maximo 30 piezas","Color;#ff6b6b")
    }
    Else
    {
        Screen:Text(4,3)("Text;Circuito muy grande","Color;#ff6b6b")
    }
    Screen:Text(256,3)("Text;I:{sIt}A","Color;white")

    Call:boton(3,138,52,1)
    Call:boton(56,138,52,2)
    Call:boton(109,138,52,3)
    Call:boton(162,138,52,4)
    Call:boton(215,138,52,5)
    Call:boton(268,138,51,6)
    Screen:Text(5,143)("Text;BAT","Color;white")
    Screen:Text(58,143)("Text;FOCO","Color;white")
    Screen:Text(111,143)("Text;SW","Color;white")
    Screen:Text(164,143)("Text;CABLE","Color;white")
    Screen:Text(217,143)("Text;BORRAR","Color;white")
    Screen:Text(270,143)("Text;EDITAR","Color;white")

    Screen:Text(4,163)("Text;V:{vbat}","Color;white")
    Screen:Rect(38,158,18,18)("Color;#2a3a4a")
    Screen:Text(43,163)("Text;-","Color;white")
    Screen:Rect(58,158,18,18)("Color;#2a3a4a")
    Screen:Text(63,163)("Text;+","Color;white")
    Screen:Text(82,163)("Text;R:{rfoc}","Color;white")
    Screen:Rect(116,158,18,18)("Color;#2a3a4a")
    Screen:Text(121,163)("Text;-","Color;white")
    Screen:Rect(136,158,18,18)("Color;#2a3a4a")
    Screen:Text(141,163)("Text;+","Color;white")
    Screen:Rect(160,158,76,18)("Color;#2a3a4a")
    Screen:Text(172,163)("Text;EJEMPLO","Color;white")
    Screen:Rect(240,158,76,18)("Color;#2a3a4a")
    Screen:Text(252,163)("Text;LIMPIAR","Color;white")
}

Print("Editor de circuitos: elige una pieza, toca dos puntos de la cuadricula y cierra el circuito")
Call:ejemplo()
Call:dibujar()

Task:animar
{
    Loop:Forever
    {
        For:ed(0,etype.length)
        {
            If(etype[ed]==1 || etype[ed]==2)
            {
                Set:eph("Index;ed","Value;eph[ed]+max(-4,min(4,ecur[ed]*2))")
            }
        }
        Call:dibujar()
        Wait("ms;60")
    }
}

On:Canvas("Click")
{
    Call:toque()
}

On:Key("Down")
{
    If(key=='Escape')
    {
        Set:pend("Value;-1")
        Set:est("Value;0")
    }
}
