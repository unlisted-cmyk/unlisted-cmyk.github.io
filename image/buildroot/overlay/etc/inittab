# Log OS: BusyBox init. Log is the only program on the console; when it ends, init starts it again.
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# The Log terminal on the HDMI/keyboard console (and on the serial port if you want it there too: duplicate the line with ttyAMA0)
tty1::respawn:/usr/bin/logl-session

::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
